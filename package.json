{
  "name": "tether",
  "productName": "Tether",
  "version": "0.2.4",
  "private": true,
  "description": "Tether — a local AI coding agent workbench",
  "license": "MIT",
  "type": "module",
  "main": "dist-electron/main/index.mjs",
  "scripts": {
    "postinstall": "node scripts/ensure-electron.mjs",
    "predev": "node scripts/ensure-electron.mjs && rm -rf dist-electron && tsup",
    "dev": "concurrently \"vite --host 127.0.0.1 --port 5177 --strictPort\" \"wait-on tcp:5177 && env -u ELECTRON_RUN_AS_NODE cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5177 electron .\"",
    "build:electron": "rm -rf dist-electron && tsup",
    "build:renderer": "vite build",
    "build": "pnpm build:electron && pnpm build:renderer",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "pnpm typecheck && pnpm test && pnpm build",
    "pack": "pnpm build && electron-builder --mac --win",
    "pack:mac": "pnpm build && electron-builder --mac",
    "pack:win": "pnpm build && electron-builder --win",
    "start": "electron ."
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "tether-agent-core": "0.1.10"
  },
  "devDependencies": {
    "@types/node": "^24.0.10",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^5.1.0",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "electron": "^37.3.1",
    "electron-builder": "^26.0.12",
    "tsup": "^8.5.0",
    "typescript": "^5.9.2",
    "vite": "^7.1.5",
    "vitest": "^3.2.4",
    "wait-on": "^8.0.4"
  },
  "engines": {
    "node": ">=22.19.0"
  }
}
